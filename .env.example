# Hangar configuration: copy to .env and adjust. All variables are optional.
# The daemon reads these from the environment once at startup (web_server.main);
# .env itself is not auto-loaded, source it from your shell (e.g. `set -a; . ./.env`).
# .env is gitignored, never commit a real KV_API_KEY.

# X-API-Key secret for the HTTP API: 1-64 bytes of printable ASCII (no spaces
# or control characters). Unset (or left at the built-in default "hangar")
# keeps the daemon bound to loopback only. Setting a strong, unique value ALSO
# exposes the daemon on all interfaces (::), so only set it for non-local
# deployments. An empty, over-64-byte, or whitespace/control-char value aborts
# startup (this rejects a stray trailing newline from `$(cat keyfile)`).
# NOTE: the bundled browser UI always sends the default key, so once KV_API_KEY
# is set its write-actions return 401, drive an authenticated daemon with the
# vmrun CLI (it sends KV_API_KEY) rather than the browser.
#KV_API_KEY=change-me-to-a-strong-secret

# TCP listen port. Must parse as a non-zero u16 (1-65535); otherwise startup aborts.
#KV_PORT=9080

# Base dir for ~/.config/hangar/* state (vms.json, networks.json).
#HANGAR_CONFIG_HOME=/home/youruser
