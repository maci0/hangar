{
  "name": "hangar",
  "version": "0.4.0",
  "private": true,
  "packageManager": "bun@1.4.0",
  "type": "module",
  "scripts": {
    "e2e": "bun ./node_modules/@playwright/test/cli.js test",
    "e2e:install": "bun ./node_modules/@playwright/test/cli.js install chromium",
    "build:web": "bun scripts/build-web.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src/web/ui",
    "lint": "oxlint --deny-warnings",
    "check:contrast": "bun scripts/contrast.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@rikalabs/oxlint-standards": "^0.8.1",
    "@shadcn/lint": "^0.2.0",
    "@tailwindcss/cli": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@webgpu/types": "^0.1.74",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elkjs": "0.11.1",
    "oxlint": "1.57.0",
    "oxlint-tsgolint": "0.17.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "preact": "^10.29.8"
  }
}
